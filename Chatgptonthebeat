-- ========== request (now validates actual HTTP responses) ==========
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({Url = "http://httpbin.org/get", Method = "GET"})
	end)
	if not ok then return false, "request failed: " .. tostring(res) end
	return type(res) == "table" and res.StatusCode == 200
end)
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({Url = "http://httpbin.org/post", Method = "POST", Body = "test"})
	end)
	if not ok then return false, tostring(res) end
	return res.StatusCode == 200 and res.Body and res.Body:find("test")
end)
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({Url = "invalid-url", Method = "GET"})
	end)
	-- Should fail, pcall catches the error
	return not ok
end)
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({})
	end)
	return not ok
end)
addSubTest("request", function() return type(request) == "function" end)
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({Url = "http://httpbin.org/status/404"})
	end)
	if not ok then return false, tostring(res) end
	return res.StatusCode == 404
end)
addSubTest("request", function()
	local ok, res = pcall(function()
		return request({
			Url = "http://httpbin.org/headers",
			Headers = {["X-Test"] = "UNC"}
		})
	end)
	if not ok then return false, tostring(res) end
	return res.Body and res.Body:find("UNC")
end)
addSubTest("request", function()
	-- test that request can handle timeout (short timeout to avoid hanging)
	local ok, res = pcall(function()
		return request({Url = "http://httpbin.org/delay/5", Method = "GET", Timeout = 1})
	end)
	-- Should either fail with timeout or succeed quickly; we check that it didn't hang
	return true  -- survivability test, but at least we used timeout
end)

